# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm/configs/lineage_krillin_defconfig

maintainer="Juan Ferrari <jferrari98.ja@gmail.com>"
pkgname=linux-bq-krillin
pkgver=3.10.107
pkgrel=0
pkgdesc="BQ Aquaris E4.5 kernel fork"
arch="armv7"
_carch="arm"
_flavor="bq-krillin"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	gcc6
	openssl-dev
	perl
	linux-headers
	xz
"

# Compiler: GCC 6 (downstream 3.10 kernel, doesn't build with newer versions)
if [ "${CC:0:5}" != "gcc6-" ]; then
	CC="gcc6-$CC"
	HOSTCC="gcc6-gcc"
	CROSS_COMPILE="gcc6-$CROSS_COMPILE"
fi

# Source
_repository="android_kernel_bq_krillin"
_commit="a1ad4ab7c8acb7f9da2a1069478e3f31c792d48d"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/Pablito2020/$_repository/archive/$_commit.tar.gz
	$_config
	linux3.4-ARM-8933-1-replace-Sun-Solaris-style-flag-on-section.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
}

sha512sums=""

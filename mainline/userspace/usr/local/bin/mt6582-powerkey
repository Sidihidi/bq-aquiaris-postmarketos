#!/usr/bin/env python3
# mt6582-powerkey — boton de encendido del BQ Aquaris E4.5 (krillin), comportamiento "movil normal":
#
#   Pulsacion CORTA (< LONG s):
#       - pantalla ENCENDIDA -> BLOQUEAR (lockscreen de Phosh) + apagar el LCD.
#       - pantalla APAGADA   -> encender el LCD (Phosh muestra el lockscreen para desbloquear).
#   Pulsacion LARGA (>= LONG s):
#       - APAGAR el movil (poweroff).
#
# Lee KEY_POWER (116) del driver kernel mtk-pmic-keys (/dev/input/eventN). El bloqueo se hace por el
# D-Bus de la SESION de Phosh (org.gnome.ScreenSaver.SetActive), alcanzada leyendo el
# DBUS_SESSION_BUS_ADDRESS del proceso phosh (corre en un dbus-run-session aislado: elogind no ve la
# sesion, por eso no vale loginctl). Corre como root desde /etc/local.d; read()/select() bloqueante = 0 CPU.
#
# Historia: el daemon viejo solo hacia toggle del backlight en el press y no bloqueaba; y antes de eso
# uno que sondeaba el registro INT0 del PMIC por pwrap se peleaba con el driver kernel. Este usa el
# input del kernel y coordina el bloqueo con Phosh.

import struct, glob, os, time, select, subprocess, pwd

BL = "/sys/class/backlight/backlight"
BR = BL + "/brightness"
MX = BL + "/max_brightness"
# El backlight lo maneja mt6582-backlight.py (PWM por /dev/mem). Apaga la pantalla SOLO si existe este
# flag (pone el duty del PWM a 0); NO honra bl_power ni brightness=0. Crear/borrar el flag = off/on.
SCREEN_OFF_FLAG = "/run/mt6582-screen-off"
KEY_POWER = 116
EV_KEY = 1
FMT = "llHHi"                 # input_event armv7 (32-bit): time(2*long)=8 + type,code(H,H) + value(i) = 16B
SZ = struct.calcsize(FMT)
LONG = 1.5                    # s: umbral corto/largo (largo = apagar)


def find_ev():
    for e in sorted(glob.glob("/sys/class/input/event*")):
        try:
            if "mtk-pmic-keys" in open(e + "/device/name").read():
                return "/dev/input/" + os.path.basename(e)
        except Exception:
            pass
    return None


def read_int(p, d=0):
    try:
        return int(open(p).read().strip())
    except Exception:
        return d


def screen_is_on():
    return not os.path.exists(SCREEN_OFF_FLAG)   # el flag existe => backlight OFF


def screen_off():
    try:
        open(SCREEN_OFF_FLAG, "w").close()       # mt6582-backlight.py pone el PWM a 0
    except Exception:
        pass


def screen_on(level=None):
    try:
        os.remove(SCREEN_OFF_FLAG)               # mt6582-backlight.py restaura el brillo de /sys
    except Exception:
        pass


def set_bl(v):
    try:
        open(BR, "w").write(str(v))
    except Exception:
        pass


def phosh_env():
    """(bus, xdg_runtime, user) del proceso phosh, o None."""
    for p in glob.glob("/proc/[0-9]*"):
        try:
            comm = open(p + "/comm").read().strip()
            cmd = open(p + "/cmdline").read()
            if comm != "phosh" and "libexec/phosh" not in cmd:
                continue
            env = dict(x.split("=", 1) for x in open(p + "/environ").read().split("\0") if "=" in x)
            bus = env.get("DBUS_SESSION_BUS_ADDRESS")
            if not bus:
                continue
            uid = os.stat(p).st_uid
            return bus, env.get("XDG_RUNTIME_DIR", "/run/user/%d" % uid), pwd.getpwuid(uid).pw_name
        except Exception:
            pass
    return None


def phosh_lock(active):
    e = phosh_env()
    if not e:
        return
    bus, xdg, user = e
    g = ("gdbus call --session --dest org.gnome.ScreenSaver "
         "--object-path /org/gnome/ScreenSaver "
         "--method org.gnome.ScreenSaver.SetActive %s") % ("true" if active else "false")
    try:
        subprocess.run(
            ["su", user, "-s", "/bin/sh", "-c",
             "export DBUS_SESSION_BUS_ADDRESS='%s'; export XDG_RUNTIME_DIR='%s'; %s" % (bus, xdg, g)],
            timeout=5)
    except Exception:
        pass


def wait_release_or_long(fd):
    """Tras un press, espera el release (val==0) hasta LONG s. True = pulsacion LARGA."""
    t0 = time.monotonic()
    while True:
        rem = LONG - (time.monotonic() - t0)
        if rem <= 0:
            return True                      # sigue pulsado tras LONG s -> largo
        r, _, _ = select.select([fd], [], [], rem)
        if not r:
            return True
        d = fd.read(SZ)
        if not d or len(d) < SZ:
            continue
        _, _, typ, code, val = struct.unpack(FMT, d)
        if typ == EV_KEY and code == KEY_POWER and val == 0:
            return False                     # release antes de LONG -> corto
        # val==2 (autorepeat) u otros: seguir esperando


def power_menu():
    """Menu de apagado: lanza el helper (notificacion con botones) EN LA SESION, lee la accion
    elegida por stdout y la ejecuta como root (poweroff/reboot). 'cancel' -> no hace nada."""
    screen_on(read_int(MX, 10))              # asegurar pantalla ON para ver el menu
    e = phosh_env()
    if not e:
        subprocess.run(["poweroff"])          # sin sesion Phosh -> apagar directo (fallback)
        return
    bus, xdg, user = e
    action = "cancel"
    try:
        r = subprocess.run(
            ["su", user, "-s", "/bin/sh", "-c",
             "export DBUS_SESSION_BUS_ADDRESS='%s'; export XDG_RUNTIME_DIR='%s'; "
             "python3 /usr/local/bin/mt6582-powermenu" % (bus, xdg)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            universal_newlines=True, timeout=45)
        out = [l for l in (r.stdout or "").strip().splitlines() if l.strip()]
        if out:
            action = out[-1].strip()
    except Exception:
        action = "cancel"
    if action == "poweroff":
        subprocess.run(["poweroff"])
    elif action == "reboot":
        subprocess.run(["reboot"])
    # cancel -> no hacer nada


def main():
    ev = find_ev()
    while ev is None:                        # esperar a que el kernel registre el input
        time.sleep(2)
        ev = find_ev()
    saved = read_int(MX, 10) or 10
    fd = open(ev, "rb", buffering=0)
    while True:
        d = fd.read(SZ)
        if not d or len(d) < SZ:
            continue
        _, _, typ, code, val = struct.unpack(FMT, d)
        if typ != EV_KEY or code != KEY_POWER or val != 1:
            continue                         # solo actuamos desde el PRESS

        if wait_release_or_long(fd):
            # PULSACION LARGA -> menu de apagado (notificacion con botones Apagar/Reiniciar)
            power_menu()
        else:
            # PULSACION CORTA -> toggle pantalla (bl_power) + bloqueo
            if screen_is_on():
                cur = read_int(BR, 0)
                if cur > 0:
                    saved = cur                  # recordar el brillo para restaurarlo
                screen_off()                     # backlight OFF de verdad (bl_power=4)
                phosh_lock(True)                 # bloquear la sesion
            else:
                screen_on(saved)                 # backlight ON (Phosh muestra el lockscreen)


if __name__ == "__main__":
    main()

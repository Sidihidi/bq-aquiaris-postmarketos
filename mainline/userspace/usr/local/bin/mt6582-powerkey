#!/usr/bin/env python3
# mt6582-powerkey — boton de encendido del BQ Aquaris E4.5 (krillin), comportamiento "movil normal":
#
#   Pulsacion CORTA (< LONG s):
#       - pantalla ENCENDIDA -> BLOQUEAR (lockscreen de Phosh) + apagar el LCD (PWM a 0).
#       - pantalla APAGADA   -> encender el LCD + FORZAR el panel DRM a On (wlr-randr).
#   Pulsacion LARGA (>= LONG s):
#       - menu de apagado (notificacion con botones; si hay lockscreen, pide desbloquear antes).
#
# v3 — DUEÑO UNICO del boton (fix del "no vuelve la GUI"):
#   * EVIOCGRAB en el evdev: Phosh/phoc/gsd-power YA NO ven KEY_POWER. Antes habia 3 actores
#     (este daemon, phosh y gsd-power con power-button-action=suspend) pisandose: phosh apagaba
#     el panel (dpms Off) al primer toque y NUNCA lo re-encendia al segundo (su inhibit de logind
#     falla con AccessDenied en esta sesion aislada) -> backlight encendido con panel negro.
#     Medido con press-monitor 2026-07-05: flag/PWM correctos, dpms Off de un solo sentido.
#   * screen_on() ademas fuerza el output con wlr-randr --on (por si phosh apago el panel por su
#     cuenta, p.ej. el fade del lockscreen).
#   * gsd-power: power-button-action=nothing (dconf, persistente) — puesto el 2026-07-05.
#
# Lee KEY_POWER (116) del driver kernel mtk-pmic-keys (/dev/input/eventN). El bloqueo se hace por el
# D-Bus de la SESION de Phosh (org.gnome.ScreenSaver.SetActive), alcanzada leyendo el
# DBUS_SESSION_BUS_ADDRESS del proceso phosh (corre en un dbus-run-session aislado: elogind no ve la
# sesion, por eso no vale loginctl). Corre como root desde /etc/local.d; read() bloqueante = 0 CPU.

import struct, glob, os, time, select, subprocess, pwd, fcntl

LOGF = "/tmp/powerkey.log"


def log(msg):
    try:
        with open(LOGF, "a") as f:
            f.write("%.2f %s\n" % (time.monotonic(), msg))
    except Exception:
        pass

BL = "/sys/class/backlight/backlight"
BR = BL + "/brightness"
MX = BL + "/max_brightness"
# El backlight lo maneja mt6582-backlight.py (PWM por /dev/mem). Apaga la pantalla SOLO si existe
# este flag (duty del PWM a 0); NO honra bl_power ni brightness=0. Crear/borrar el flag = off/on.
SCREEN_OFF_FLAG = "/run/mt6582-screen-off"
KEY_POWER = 116
EV_KEY = 1
FMT = "llHHi"                 # input_event armv7 (32-bit): time(2*long)=8 + type,code(H,H) + value(i) = 16B
SZ = struct.calcsize(FMT)
LONG = 1.5                    # s: umbral corto/largo
DEBOUNCE = 0.35               # s: ignorar pulsaciones-metralleta
EVIOCGRAB = 0x40044590        # _IOW('E', 0x90, int)


def find_ev():
    for e in sorted(glob.glob("/sys/class/input/event*")):
        try:
            if "mtk-pmic-keys" in open(e + "/device/name").read():
                return "/dev/input/" + os.path.basename(e)
        except Exception:
            pass
    return None


def read_int(p, d=0):
    try:
        return int(open(p).read().strip())
    except Exception:
        return d


def screen_is_on():
    return not os.path.exists(SCREEN_OFF_FLAG)   # el flag existe => backlight OFF


def screen_off():
    try:
        open(SCREEN_OFF_FLAG, "w").close()       # mt6582-backlight.py pone el PWM a 0
    except Exception:
        pass


def screen_on(level=None):
    try:
        os.remove(SCREEN_OFF_FLAG)               # mt6582-backlight.py restaura el brillo de /sys
    except Exception:
        pass
    # Despertar = panel On + sesion DESBLOQUEADA (a proposito). Medido 0705: phosh funde el
    # panel al bloquear y NO hay forma externa de "despertar al lockscreen": wlr-randr --on
    # (mode-set) tira el shield; wlopm no puede (phosh posee el control output-power en
    # exclusiva); re-asertar el lock re-funde a Off; el tactil inyectado no despierta.
    # Como sxmo no tiene PIN (lockscreen = swipe, sin seguridad real), despertar directo a la
    # sesion es equivalente. El fix de verdad = registrar la sesion en elogind (PAM/greetd)
    # para que phosh maneje el boton nativo — pendiente.
    phosh_lock(False)
    output_on()                                  # forzar el panel DRM (unico wake que funciona)


def phosh_env():
    """(bus, xdg_runtime, user, wayland_display) del proceso phosh, o None."""
    for p in glob.glob("/proc/[0-9]*"):
        try:
            comm = open(p + "/comm").read().strip()
            cmd = open(p + "/cmdline").read()
            if comm != "phosh" and "libexec/phosh" not in cmd:
                continue
            env = dict(x.split("=", 1) for x in open(p + "/environ").read().split("\0") if "=" in x)
            bus = env.get("DBUS_SESSION_BUS_ADDRESS")
            if not bus:
                continue
            uid = os.stat(p).st_uid
            return (bus, env.get("XDG_RUNTIME_DIR", "/run/user/%d" % uid),
                    pwd.getpwuid(uid).pw_name, env.get("WAYLAND_DISPLAY", "wayland-0"))
        except Exception:
            pass
    return None


def run_in_session(cmdline, timeout=6, capture=False):
    """Ejecuta cmdline como el usuario de la sesion Phosh con su bus/wayland. None si no hay sesion."""
    e = phosh_env()
    if not e:
        return None
    bus, xdg, user, wld = e
    envs = ("export DBUS_SESSION_BUS_ADDRESS='%s' XDG_RUNTIME_DIR='%s' WAYLAND_DISPLAY='%s'; "
            % (bus, xdg, wld))
    try:
        return subprocess.run(["su", user, "-s", "/bin/sh", "-c", envs + cmdline],
                              stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, universal_newlines=True, timeout=timeout)
    except Exception:
        return None


def output_on():
    # re-enciende el panel DRM (phosh lo apaga en el fade del lockscreen y no lo devuelve).
    # SOLO si esta realmente Off: llamar a wlr-randr durante el fade de phosh roza una
    # carrera de capas en phoc (CRITICAL top-panel, visto 0705) — no tocar si no hace falta.
    try:
        dpms = open("/sys/class/drm/card1-DSI-1/dpms").read().strip()
    except Exception:
        dpms = "Off"
    if dpms == "Off":
        run_in_session("wlr-randr --output DSI-1 --on")


def phosh_lock(active):
    run_in_session("gdbus call --session --dest org.gnome.ScreenSaver "
                   "--object-path /org/gnome/ScreenSaver "
                   "--method org.gnome.ScreenSaver.SetActive %s" % ("true" if active else "false"))


def wait_release_or_long(fd):
    """Tras un press, espera el release (val==0) hasta LONG s. True = pulsacion LARGA."""
    t0 = time.monotonic()
    while True:
        rem = LONG - (time.monotonic() - t0)
        if rem <= 0:
            log("LARGA (sin release en %.2fs)" % LONG)
            return True
        r, _, _ = select.select([fd], [], [], rem)
        if not r:
            log("LARGA (select timeout, %.2fs)" % (time.monotonic() - t0))
            return True
        d = fd.read(SZ)
        if not d or len(d) < SZ:
            continue
        _, _, typ, code, val = struct.unpack(FMT, d)
        if typ == EV_KEY and code == KEY_POWER and val == 0:
            log("CORTA (release a %.2fs)" % (time.monotonic() - t0))
            return False
        # val==2 (autorepeat) u otros: seguir esperando


def power_menu():
    """Menu de apagado: pantalla ON + helper en la sesion (el helper gestiona el lockscreen:
    si esta bloqueado pide desbloquear y espera). stdout final: poweroff|reboot|cancel."""
    screen_on(read_int(MX, 10))
    r = run_in_session("python3 /usr/local/bin/mt6582-powermenu", timeout=75, capture=True)
    if r is None:
        subprocess.run(["poweroff"])          # sin sesion Phosh -> apagar directo (fallback)
        return
    out = [l for l in (r.stdout or "").strip().splitlines() if l.strip()]
    action = out[-1].strip() if out else "cancel"
    if action == "poweroff":
        subprocess.run(["poweroff"])
    elif action == "reboot":
        subprocess.run(["reboot"])
    # cancel -> nada


def main():
    ev = find_ev()
    while ev is None:                        # esperar a que el kernel registre el input
        time.sleep(2)
        ev = find_ev()
    saved = read_int(MX, 10) or 10
    fd = open(ev, "rb", buffering=0)
    # DUEÑO UNICO: nadie mas (phosh/phoc/gsd) recibe KEY_POWER a partir de aqui
    try:
        fcntl.ioctl(fd, EVIOCGRAB, 1)
    except Exception:
        pass
    last = 0.0
    while True:
        d = fd.read(SZ)
        if not d or len(d) < SZ:
            continue
        _, _, typ, code, val = struct.unpack(FMT, d)
        if typ != EV_KEY or code != KEY_POWER or val != 1:
            continue                         # solo actuamos desde el PRESS
        if time.monotonic() - last < DEBOUNCE:
            continue                         # metralleta: ignorar

        if wait_release_or_long(fd):
            log("accion: MENU apagado (env=%s)" % bool(phosh_env()))
            power_menu()                     # LARGA -> menu de apagado
        else:
            if screen_is_on():               # CORTA -> toggle pantalla + bloqueo
                cur = read_int(BR, 0)
                if cur > 0:
                    saved = cur
                screen_off()
                log("accion: OFF+lock (env=%s)" % bool(phosh_env()))
                phosh_lock(True)
            else:
                log("accion: ON/wake (env=%s)" % bool(phosh_env()))
                screen_on(saved)
        last = time.monotonic()


if __name__ == "__main__":
    main()

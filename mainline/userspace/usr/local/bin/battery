#!/bin/sh
# /usr/local/bin/battery — lee VBAT del MT6323 (AUXADC canal 7 = BATSNS) y estima el % de carga.
#
# DESDE 0708: la lectura va por el driver kernel hwmon mt6323-auxadc (regmap del mt6397 =
# pwrap CON lock), en vez de pwrap_poke (MMIO crudo sin lock, sospechoso del wedge del
# bloque de INT del PMIC del 0708). El driver ya promedia 8 muestras y devuelve mV en
# /sys/class/hwmon/hwmonN/in0_input (name=mt6323_auxadc).
# La receta AUXADC y la escala (raw*4*1800/32768) viven ahora en el driver.
# El pwrap_poke queda SOLO para diagnostico manual: /usr/local/bin/battery-pwrap.
#
# COMPENSACION DE CARGA (0706): un gauge por-voltaje SIN sensado de corriente miente bajo
# carga -> al CARGAR el VBAT esta inflado (caida I*R del cargador) y al DESCARGAR esta
# hundido. Estimamos el OCV (voltaje en reposo) restando/sumando una caida I*R tipica antes
# de la curva:
#   - cargando:    OCV ~= VBAT - 100 mV  (~700 mA * ~140 mOhm, R interna del krilin r_profile_t2)
#   - descargando: OCV ~= VBAT + 40 mV   (carga media tipica; pantalla on ~300 mA)
# El % sale de una curva OCV de Li-ion en reposo (interina pero razonable).
#
# TRABAJO FUTURO (gauge preciso): tabla ZCV real + coulomb-counting del HW fuel gauge del
# MT6323 (krilin_cust_battery_meter_table.h del downstream), leyendo la corriente por el
# driver kernel (nunca mas pwrap_poke periodico).

hw=
for n in /sys/class/hwmon/hwmon*/name; do
  [ -e "$n" ] || continue
  if [ "$(cat "$n" 2>/dev/null)" = "mt6323_auxadc" ]; then hw=${n%/name}; break; fi
done
if [ -z "$hw" ] || [ ! -r "$hw/in0_input" ]; then
  echo "battery: sin hwmon mt6323_auxadc (¿kernel sin el driver? usa battery-pwrap SOLO para diagnostico)" >&2
  exit 1
fi

mv=$(cat "$hw/in0_input") || exit 1
case "$mv" in ''|*[!0-9]*) echo "battery: lectura invalida '$mv'" >&2; exit 1;; esac

# estado de carga -> compensacion I*R para estimar OCV
st=$(/usr/local/bin/charge-status 2>/dev/null | grep -o 'STAT=[A-Z]*' | head -1)
case "$st" in
  *CARGANDO*) ocv=$(( mv - 100 )); chg=chg ;;
  *)          ocv=$(( mv + 40 )); chg=dis ;;
esac

# % piecewise por curva OCV (reposo) Li-ion
if   [ $ocv -ge 4200 ]; then pct=100
elif [ $ocv -ge 4000 ]; then pct=$(( 80 + (ocv-4000)*20/200 ))
elif [ $ocv -ge 3850 ]; then pct=$(( 60 + (ocv-3850)*20/150 ))
elif [ $ocv -ge 3700 ]; then pct=$(( 30 + (ocv-3700)*30/150 ))
elif [ $ocv -ge 3400 ]; then pct=$(( (ocv-3400)*30/300 ))
else pct=0; fi
[ $pct -gt 100 ] && pct=100
[ $pct -lt 0 ] && pct=0

# VBAT = voltaje real medido (para el display); el % ya lleva la compensacion de carga.
# Formato ESTABLE: battery-upower parsea 'VBAT:\s*(\d+)\s*mV.*?(\d+)\s*%'.
echo "VBAT: ${mv} mV  (~${pct}%)   [ocv=${ocv} ${chg} hwmon=${hw##*/}]"

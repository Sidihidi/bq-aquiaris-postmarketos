#!/bin/sh
# zzv-battery.start — al boot: carga el power_supply de pega y arranca el daemon de batería->UPower.
# (start-stop-daemon es robusto: el "( cmd & )" por SSH no sobrevive; éste sí.)
[ -e /sys/module/test_power ] || insmod /usr/local/lib/test_power.ko 2>/dev/null
start-stop-daemon --start --background --make-pidfile --pidfile /run/battery-upower.pid \
  --exec /usr/bin/python3 -- /usr/local/bin/battery-upower

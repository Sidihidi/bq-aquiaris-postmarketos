#!/usr/bin/env python3
# mt6582-autobrightness — auto-brillo por el ALS TMD2772 (iio tsl2772).
#
# Lee lux de /sys (sin D-Bus/sensor-proxy: mas simple y sin polkit) cada POLL s
# y escribe el objetivo en /run/mt6582-bl-pct — el MISMO canal que el slider de
# Phosh (shim) — que consume el daemon mt6582-backlight (PWM). "El ultimo que
# escribe gana", asi que convive con el slider; para no pelearse con el usuario:
# si alguien mas cambia el fichero (slider), NOS APARTAMOS hasta que la luz
# ambiente cambie ~3x respecto al momento del ajuste manual (o reboot).
#
# El sensor arranca de fabrica con integracion 2.73 ms y ganancia 1 => con luz
# de interior lee 0. Aqui se configura 699 ms + ganancia 16 (unico itime largo
# disponible; a plena luz el driver satura y reporta max_lux — a esos niveles
# el brillo ya esta al 100%, da igual).
#
# NO usa gsd-power (su power plugin resucita la regresion de auto-suspend).
import glob
import math
import os
import time

PCT = "/run/mt6582-bl-pct"
OFF = "/run/mt6582-screen-off"
POLL = 1.0          # s entre lecturas
DEADBAND = 6        # no ajustar si |objetivo-actual| <= esto (histeresis)
OVERRIDE_RATIO = 3.0  # volver del modo manual si la luz cambia 3x

# curva CUENTAS CRUDAS ch0 -> % (interpolacion en log10(c+1)).
# OJO: NO usar in_illuminance0_input (lux): la formula del driver con la tabla
# del DT resta 35000*ch1 y con luz calida de interior (mucho IR) da 0 SIEMPRE
# (visto en HW: ch0=31, lux=0). Las cuentas ch0 con 699ms+gain16: oscuridad
# 0-2, lampara de noche ~30, interior iluminado ~centenares, sol = miles.
CURVE = [(0, 12), (5, 18), (30, 35), (150, 55), (800, 75), (5000, 100)]


def find_als():
    for n in glob.glob("/sys/bus/iio/devices/iio:device*/name"):
        try:
            if "tmd2772" in open(n).read() or "tsl2772" in open(n).read():
                return os.path.dirname(n)
        except Exception:
            pass
    return None


def setup(dev):
    for f, v in (("in_intensity0_integration_time", "0.699000"),
                 ("in_intensity0_calibscale", "16")):
        try:
            with open(os.path.join(dev, f), "w") as fh:
                fh.write(v)
        except Exception:
            pass


def read_lux(dev):
    """Cuentas crudas del canal visible (ch0) — ver nota de CURVE."""
    try:
        return max(0, int(open(dev + "/in_intensity0_raw").read().strip()))
    except Exception:
        return None


def curve_pct(lux):
    lg = math.log10(lux + 1)
    pts = [(math.log10(l + 1), p) for l, p in CURVE]
    if lg <= pts[0][0]:
        return pts[0][1]
    for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
        if lg <= x1:
            return int(round(y0 + (y1 - y0) * (lg - x0) / (x1 - x0)))
    return pts[-1][1]


def read_pct():
    try:
        return max(0, min(100, int(open(PCT).read().strip())))
    except Exception:
        return None


def write_pct(v):
    try:
        with open(PCT, "w") as f:
            f.write(str(int(v)))
        return True
    except Exception:
        return False


def main():
    dev = find_als()
    while dev is None:
        time.sleep(5)
        dev = find_als()
    setup(dev)

    last_written = None        # ultimo valor que escribimos NOSOTROS
    override_lux = None        # lux en el momento del ajuste manual (None = auto)

    while True:
        time.sleep(POLL)
        if os.path.exists(OFF):
            continue                          # pantalla apagada: no tocar
        lux = read_lux(dev)
        if lux is None:
            setup(dev)                        # p.ej. tras resume: reconfigurar
            continue
        cur = read_pct()
        if cur is None:
            continue

        # ajuste manual detectado: el fichero no vale lo ultimo que escribimos
        if last_written is not None and cur != last_written:
            override_lux = max(lux, 1)
            last_written = cur
            continue

        if override_lux is not None:
            r = (lux + 1) / float(override_lux + 1)
            if 1.0 / OVERRIDE_RATIO < r < OVERRIDE_RATIO:
                continue                      # el usuario manda; luz sin cambios
            override_lux = None               # la luz cambio de verdad: retomar

        target = curve_pct(lux)
        diff = target - cur
        if abs(diff) <= DEADBAND:
            continue
        # rampa proporcional: cambios grandes avanzan rapido (1/3 del gap por
        # tick de 1s, min 3, max 15) — la v1 iba a 4pts/2s y tardaba ~20s en
        # reaccionar a una linterna: parecia rota
        step = max(3, min(15, abs(diff) // 3))
        nxt = cur + (step if diff > 0 else -step)
        if write_pct(nxt):
            last_written = nxt


if __name__ == "__main__":
    main()

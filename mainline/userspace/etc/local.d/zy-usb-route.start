#!/bin/sh
# Internet por el tethering USB a la Pi (NAT en la Pi @172.16.42.2).
# Espera a usb0 y fija ruta default + DNS. Solo aplica con esta Pi conectada.
for i in $(seq 1 15); do ip addr show usb0 2>/dev/null | grep -q "172.16.42.1" && break; sleep 1; done
ip route replace default via 172.16.42.2 2>/dev/null
grep -q "8.8.8.8" /etc/resolv.conf 2>/dev/null || echo "nameserver 8.8.8.8" >> /etc/resolv.conf

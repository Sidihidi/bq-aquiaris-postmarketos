#!/bin/sh
# Auto-suspend en idle: arranca el daemon mt6582-autosuspend al boot.
# Suspende en s2idle cuando la PANTALLA lleva 60s apagada, salvo inhibidores
# (audio sonando, sesion SSH activa, o flag /run/mt6582-no-suspend). Wake por
# el BOTON de encendido (lo gestiona mt6582-powerkey). El wrapper mt6582-suspend
# repara usb0 al resumir. Corre despues del powerkey (zzw) por el nombre (zzy).
#
# Para DESACTIVAR temporalmente sin tocar el boot: `touch /run/mt6582-no-suspend`.
start-stop-daemon --start --background --make-pidfile --pidfile /run/mt6582-autosuspend.pid \
  --exec /usr/local/bin/mt6582-autosuspend

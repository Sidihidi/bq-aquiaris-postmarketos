#!/bin/sh
# Robust sshd bring-up. El arranque normal de sshd compite con el timing del
# boot temprano (falla y no se recupera). Reintenta en background hasta que suba,
# sin bloquear el resto de local.d (Phosh).
(
  i=0
  while [ $i -lt 12 ]; do
    if pgrep -x sshd >/dev/null 2>&1; then exit 0; fi
    rc-service sshd zap >/dev/null 2>&1
    rm -f /run/sshd.pid 2>/dev/null
    rc-service sshd start >/dev/null 2>&1 || /usr/sbin/sshd >/dev/null 2>&1
    sleep 2
    i=$((i + 1))
  done
) &

#!/bin/sh
# Levanta el CONSYS Bluetooth (hci0) antes que Phosh (zz < zzzz) -> el toggle BT sale activo.
mount -t debugfs none /sys/kernel/debug 2>/dev/null
i=0
while [ $i -lt 20 ] && [ ! -e /sys/kernel/debug/mt6582_btif/bringup ]; do sleep 1; i=$((i+1)); done
if [ -e /sys/kernel/debug/mt6582_btif/bringup ]; then
  timeout 50 sh -c 'echo 1 > /sys/kernel/debug/mt6582_btif/bringup'
  sleep 2
  bluetoothctl power on >/dev/null 2>&1
fi

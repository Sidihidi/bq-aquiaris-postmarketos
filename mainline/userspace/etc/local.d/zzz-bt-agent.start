#!/bin/sh
# Agente de emparejamiento BT permanente (auto-acepta passkey). Corre tras zz-consys-bt.
( i=0
  while [ $i -lt 30 ] && ! hciconfig hci0 >/dev/null 2>&1; do sleep 1; i=$((i+1)); done
  pkill -f bluetoothctl 2>/dev/null
  sleep 1
  setsid sh -c '( printf "agent NoInputNoOutput
default-agent
pairable on
discoverable on
"; while true; do echo yes; sleep 2; done ) | bluetoothctl >/dev/null 2>&1' </dev/null >/dev/null 2>&1 &
) &

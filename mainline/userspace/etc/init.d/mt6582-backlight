#!/sbin/openrc-run
name="mt6582-backlight"
description="MT6582 BLS backlight bridge (Phosh slider -> PWM_DUTY +0xa0)"
command="/usr/bin/python3"
command_args="/usr/local/bin/mt6582-backlight.py"
command_background=true
pidfile="/run/mt6582-backlight.pid"
output_log="/var/log/mt6582-backlight.log"
error_log="/var/log/mt6582-backlight.log"
depend() {
    after modules localmount
}

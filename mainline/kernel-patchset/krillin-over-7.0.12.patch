+	fm_s32 patch_ver;	/* FM DSP patch version, eg. 1.11 */
+	fm_s32 reserve;
+};
+
+struct fm_i2s_setting {
+	fm_s32 onoff;
+	fm_s32 mode;
+	fm_s32 sample;
+};

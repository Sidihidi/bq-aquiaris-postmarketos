+		      NULL);
+	FM_UNLOCK(cmd_buf_lock);
+
+	if (ret) {
+		WCN_DBG(FM_ALT | CHIP, "mt6627_tune failed\n");
+		return ret;
+	}
+
+	WCN_DBG(FM_DBG | CHIP, "set freq to %d ok\n", freq);
+#if 0
+	/* ADPLL setting for dbg */
+	mt6627_top_write(0x0050, 0x00000007);

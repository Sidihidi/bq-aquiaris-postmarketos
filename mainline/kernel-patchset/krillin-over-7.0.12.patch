+ * the low level func to write a rigister
+ * @addr - rigister address
+ * @val - value will be writed in the rigister
+ * If success, return 0; else error code
+ */
+fm_s32 fm_ctrl_tx(fm_u8 addr, fm_u16 val)
+{

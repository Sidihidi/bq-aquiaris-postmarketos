+} rds_blk_t;
+
+/* For RDS feature, these strcutures also be defined in "fm.h" */
+typedef struct rds_flag_t {
+	fm_u8 TP;
+	fm_u8 TA;
+	fm_u8 Music;
+	fm_u8 Stereo;
+	fm_u8 Artificial_Head;

+/******************************************************************************
+ * STRUCTURE DEFINITIONS
+ *****************************************************************************/
+enum fm_op_state {
+	FM_STA_STOP = 0,
+	FM_STA_PLAY = 1,
+	FM_STA_TUNE = 2,
+	FM_STA_SEEK = 3,
+	FM_STA_SCAN = 4,
+	FM_STA_RAMPDOWN = 5,

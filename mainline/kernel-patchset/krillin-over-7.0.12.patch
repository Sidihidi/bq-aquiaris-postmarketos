+	mt6627_bt_write(0x82, 0x11);
+	mt6627_bt_write(0x83, 0x11);
+	mt6627_bt_write(0x84, 0x11);
+	mt6627_top_write(0x0040, 0x1C1C1C1C);
+	mt6627_top_write(0x0044, 0x1C1C1C1C);
+	mt6627_write(0x70, 0x0010);
+	/*0x0806 DCO clk
+	   0x0802 ref clk

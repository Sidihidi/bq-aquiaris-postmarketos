+
+	WCN_DBG(FM_INF | MAIN, "MCU %d\n", ret);
+
+	/* GPS clock adjust if need */
+	if ((ret = mt6627_gps_dese(freq, NULL)) < 0) {
+		WCN_DBG(FM_ERR | MAIN, "mt6627_gps_dese FAIL:%d\n", ret);

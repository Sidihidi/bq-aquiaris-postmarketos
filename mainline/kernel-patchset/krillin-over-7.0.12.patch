+static fm_s32 mt6627_restore_search(void)
+{
+	mt6627_RampDown();
+	/* set audio output I2S Tx mode */
+	mt6627_write(0x9B, 0xF9AB);
+	/* set audio output I2S Rx mode */
+	mt6627_host_write(0x80101054, 0x00003f35);
+	return 0;
+}

+static fm_s32 mt6627_GetCapArray(fm_s32 *ca)
+{
+	fm_u16 dataRead;
+	fm_u16 tmp = 0;
+
+	FMR_ASSERT(ca);
+	mt6627_read(0x60, &tmp);
+	mt6627_write(0x60, tmp & 0xFFF7);	/* 0x60 D3=0 */
+
+	mt6627_read(0x26, &dataRead);
+	*ca = dataRead;
+
+	mt6627_write(0x60, tmp);	/* 0x60 D3=1 */
+	return 0;
+}

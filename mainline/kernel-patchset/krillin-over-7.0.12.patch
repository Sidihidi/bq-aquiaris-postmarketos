+extern fm_s32 rds_grp_counter_get(struct rds_group_cnt_t *dst, struct rds_group_cnt_t *src)
+{
+	FMR_ASSERT(dst);
+	FMR_ASSERT(src);
+	fm_memcpy(dst, src, sizeof(struct rds_group_cnt_t));
+	WCN_DBG(FM_DBG | RDSC, "rds gc get[total=%d]\n", (fm_s32) dst->total);
+	return 0;
+}

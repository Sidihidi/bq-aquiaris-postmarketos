+
+	freq_reg = freq;
+	if (0 == fm_get_channel_space(freq_reg)) {
+		freq_reg *= 10;
+	}
+	freq_reg = (freq_reg - 6400) * 2 / 10;
+	mt6627_set_bits(0x65, freq_reg, 0xFC00);

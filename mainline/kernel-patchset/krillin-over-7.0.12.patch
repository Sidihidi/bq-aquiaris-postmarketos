+} rds_raw_t;
+
+typedef struct rds_group_cnt_t {
+	unsigned long total;
+	unsigned long groupA[16];	/* RDS groupA counter */
+	unsigned long groupB[16];	/* RDS groupB counter */
+} rds_group_cnt_t;
+
+typedef enum rds_group_cnt_op_t {
+	RDS_GROUP_CNT_READ = 0,

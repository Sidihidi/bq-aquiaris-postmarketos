diff --git a/drivers/power/supply/mt6323-charger.c b/drivers/power/supply/mt6323-charger.c
--- a/drivers/power/supply/mt6323-charger.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/power/supply/mt6323-charger.c	2026-07-11 23:13:37.873748327 +0100
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6323 Charger driver para BQ Aquaris E4.5 (krillin)
+ *
+ * Driver mínimo que activa la carga del PMIC MT6323.
+ * El MT6323 controla la carga de batería Li-Ion via registros CHR_CON.
+ *
+ * En el downstream de MediaTek, el driver completo (mtk_battery) maneja
+ * CV/CC, temperatura, etc. Aquí solo activamos la carga básica.
+ *
+ * Registro clave: CHR_CON1 (0x0002) bit 0 = charger enable
+ *                 CHR_CON2 (0x0004) = current limit
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/mfd/mt6323/registers.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+struct mt6323_charger {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+};
+
+static int mt6323_charger_get_property(struct power_supply *psy,
+					enum power_supply_property psp,
+					union power_supply_propval *val)
+{
+	/* Por ahora reportamos que siempre está cargando si VBUS presente */
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = 1;  /* siempre online (USB conectado) */
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static enum power_supply_property mt6323_charger_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+};
+
+static const struct power_supply_desc mt6323_charger_desc = {
+	.name = "mt6323-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = mt6323_charger_props,
+	.num_properties = ARRAY_SIZE(mt6323_charger_props),
+	.get_property = mt6323_charger_get_property,
+};
+
+static int mt6323_charger_probe(struct platform_device *pdev)
+{
+	struct mt6397_chip *mt6397 = dev_get_drvdata(pdev->dev.parent);
+	struct mt6323_charger *chg;
+	struct power_supply_config cfg = {};
+	struct of_device_id *match;
+	int ret;
+
+	chg = devm_kzalloc(&pdev->dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+
+	chg->dev = &pdev->dev;
+	chg->regmap = mt6397->regmap;
+
+	platform_set_drvdata(pdev, chg);
+
+	/* Activar carga: CHR_CON1 bit 0 = 1 */
+	ret = regmap_set_bits(chg->regmap, MT6323_CHR_CON1, BIT(0));
+	if (ret) {
+		dev_err(&pdev->dev, "failed to enable charging: %d\n", ret);
+		return ret;
+	}
+
+	/* Configurar corriente de carga: CHR_CON2 = 0x06 (300mA aprox)
+	 * Bits [2:1] = current: 00=300mA, 01=400mA, 10=500mA, 11=600mA
+	 * Para USB estándar usamos 500mA */
+	regmap_write(chg->regmap, MT6323_CHR_CON2, BIT(1) | BIT(2));
+
+	/* CHR_CON4 bit 7 = enable charger after CSQ done */
+	regmap_set_bits(chg->regmap, MT6323_CHR_CON4, BIT(7));
+
+	dev_info(&pdev->dev, "MT6323 charger enabled\n");
+
+	/* Registrar power_supply para que userspace vea el estado */
+	cfg.drv_data = chg;
+	cfg.fwnode = dev_fwnode(&pdev->dev);
+	chg->psy = devm_power_supply_register(&pdev->dev,
+					     &mt6323_charger_desc, &cfg);
+	if (IS_ERR(chg->psy))
+		dev_warn(&pdev->dev, "failed to register power_supply\n");
+
+	return 0;
+}
+
+static const struct of_device_id mt6323_charger_of_match[] = {
+	{ .compatible = "mediatek,mt6323-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6323_charger_of_match);
+
+static struct platform_driver mt6323_charger_driver = {
+	.probe = mt6323_charger_probe,
+	.driver = {
+		.name = "mt6323-charger",
+		.of_match_table = mt6323_charger_of_match,
+	},
+};
+module_platform_driver(mt6323_charger_driver);
+
+MODULE_AUTHOR("krillin port");
+MODULE_DESCRIPTION("MT6323 PMIC Charger driver");
+MODULE_LICENSE("GPL");

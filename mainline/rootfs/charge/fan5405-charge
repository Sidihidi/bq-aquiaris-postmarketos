#!/bin/sh
# /usr/local/bin/fan5405-charge — "driver" userspace de carga del BQ E4.5 (mainline).
# FAN5405 en I2C0 @0x6a (vendor=4 confirmado). El watchdog del chip es ~22-24s: si no
# se kickea, revierte a 100mA/3.54V y el sistema drena mas de lo que entra. Kick cada 10s.
# Valores SEGUROS: CV=4.20V (OREG=35, topado por VSAFE/CON6), IINLIM=800mA, IOCHARGE=550mA
# (default), TE=1 (termina al llenar), CE=enable. Solo carga con USB presente.
while true; do
  i2cset -y 0 0x6a 0x02 0x8c 2>/dev/null            # CON2: OREG=4.20V
  i2cset -y 0 0x6a 0x01 0xb8 2>/dev/null            # CON1: IINLIM=800mA,LOW_V=3,TE=1,CE=on
  c0=$(i2cget -y 0 0x6a 0x00 2>/dev/null)           # CON0: kick watchdog (RMW bit7)
  [ -n "$c0" ] && i2cset -y 0 0x6a 0x00 $((c0|0x80)) 2>/dev/null
  sleep 10
done

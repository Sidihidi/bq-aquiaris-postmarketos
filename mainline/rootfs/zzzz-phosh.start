#!/bin/sh
# /etc/local.d/zzzz-phosh.start — autoarranque de Phosh (Wayland) al boot.
# Sustituye al startx (jwm). Necesita udev(eudev)+seatd+runtime dir, corre como sxmo.
rc-service udev start 2>/dev/null
rc-service udev-trigger start 2>/dev/null
rc-service seatd start 2>/dev/null
mkdir -p /run/user/1000
chown sxmo:sxmo /run/user/1000
chmod 700 /run/user/1000
sleep 3
nohup su - sxmo -c "sh /usr/local/bin/launch_phosh.sh" >/tmp/phosh-boot.log 2>&1 &

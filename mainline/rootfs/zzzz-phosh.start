#!/bin/sh
# /etc/local.d/zzzz-phosh.start — autoarranque de Phosh (Wayland) al boot.
# Sustituye al startx (jwm). Necesita udev(eudev)+seatd+runtime dir, corre como sxmo.
#
# ROBUSTO (fix "primer boot de kernel nuevo no lanza GUI"): el crng del primer boot
# va lento (~60s) -> udev tarda en crear /dev/dri/card1. En vez de un `sleep 3` ciego,
# esperamos a que el DRM real (card1) y seatd esten listos (timeout 90s).
rc-service udev start 2>/dev/null
rc-service udev-trigger start 2>/dev/null
rc-service seatd start 2>/dev/null
mkdir -p /run/user/1000
chown sxmo:sxmo /run/user/1000
chmod 700 /run/user/1000

# Esperar a que el dispositivo DRM (mtk_drm = card1) exista y seatd este arriba.
i=0
while [ $i -lt 90 ]; do
	if [ -e /dev/dri/card1 ] && rc-service seatd status 2>/dev/null | grep -q started; then
		break
	fi
	sleep 1
	i=$((i + 1))
done
# margen extra para que udev asiente los nodos input (tactil ft5336)
sleep 2

nohup su - sxmo -c "sh /usr/local/bin/launch_phosh.sh" >/tmp/phosh-boot.log 2>&1 &

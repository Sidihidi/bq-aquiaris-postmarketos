#!/bin/sh
# /etc/local.d/touch-power.start  (Alpine/OpenRC, runlevel default via servicio "local")
#
# Enciende y ARRANCA el touchscreen FT5336 del BQ Aquaris E4.5 (krillin / MT6582).
# Herramientas en /usr/local/bin (pwrap_poke, devmem).
#
# CLAVE (validado en hardware): NO basta con encender VGP1. El firmware de sensado
# del FT5336 solo arranca con un POWER-CYCLE del regulador (apagar -> esperar ->
# encender) seguido del pulso de reset. Si solo se enciende (estando ya on), el chip
# responde por I2C pero el sensado tactil queda dormido (los regs de toque leen 0xFF).
# Por eso tras un simple "encender" no se leen toques, pero tras un reboot (power-cycle
# real) si. Aqui forzamos el power-cycle por software.
#
# Sustituye al late_initcall en el kernel (que rompia el boot de sshd): en userspace,
# tras la red, es seguro. Cuando exista el driver edt-ft5x06 + regulador mt6323 en el
# DT, esto se retira (vin-supply + reset-gpios lo haran solos).
PWRAP=/usr/local/bin/pwrap_poke
DEVMEM=/usr/local/bin/devmem
$PWRAP  w 0x050A 0x0000     # VGP1 OFF (MT6323 DIGLDO_CON7 bit15)
sleep 1
$PWRAP  w 0x050A 0x8000     # VGP1 ON
sleep 1
$DEVMEM 0x10005478 0x8      # GPIO115 (reset) LOW  -> assert reset
sleep 1
$DEVMEM 0x10005474 0x8      # GPIO115 (reset) HIGH -> release
sleep 1                     # esperar boot del firmware del touch
logger -t touch-power "VGP1 power-cycle + reset FT5336" 2>/dev/null

#!/bin/sh
# /etc/local.d/touch-power.start  (Alpine/OpenRC, runlevel default via servicio "local")
# Enciende la alimentacion del touchscreen FT5336 (regulador VGP1 del PMIC MT6323)
# por el pwrap, y hace el pulso de reset del touch (GPIO115). Se ejecuta en cada
# arranque/reinicio. Herramientas en /usr/local/bin (pwrap_poke, devmem).
#
# Esto sustituye al late_initcall en el kernel (que rompia el boot de sshd): hacerlo
# en userspace, tras la red, es seguro. Cuando exista el driver edt-ft5x06 + el
# regulador mt6323 en el DT, esto se podra retirar (vin-supply lo encendera solo).
/usr/local/bin/pwrap_poke w 0x050A 0x8000   # MT6323 DIGLDO_CON7 bit15 = VGP1 EN
/usr/local/bin/devmem 0x10005478 0x8         # GPIO115 (reset) LOW
sleep 1
/usr/local/bin/devmem 0x10005474 0x8         # GPIO115 (reset) HIGH
logger -t touch-power "VGP1 ON + reset touch FT5336" 2>/dev/null

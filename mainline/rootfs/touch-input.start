#!/bin/sh
# /etc/local.d/zzz-touch-input.start — uinput + reset fiable + daemon del touch.
# Corre tras touch-power.start (VGP1). Reset determinista del FT5336 -> init limpio.
[ -e /dev/uinput ] || insmod /root/uinput.ko 2>/dev/null
/usr/local/bin/touch-reset 2>/dev/null
pgrep ft5336_touch >/dev/null 2>&1 || ( /usr/local/bin/ft5336_touch >/tmp/ft.log 2>&1 & )

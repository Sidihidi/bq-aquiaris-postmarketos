#!/bin/sh
# /usr/local/bin/touch-reset — reset FIABLE del FT5336 via GPIO115 (banco7 bit3).
# Identificado 2026-06-17: el "fallo" era interpretacion; los registros estaban bien.
#   DOUT val=0x10005470, SET=0x10005474, RST=0x10005478 ; escribir 0x08 = bit3 (GPIO115)
#   0x478<-0x08 => bit3 LOW (reset asertado, active-low); 0x474<-0x08 => HIGH (liberado)
D=/usr/local/bin/devmem
$D 0x10005478 0x08 >/dev/null    # GPIO115 LOW  (reset asertado)
sleep 0.01 2>/dev/null || sleep 1
$D 0x10005474 0x08 >/dev/null    # GPIO115 HIGH (reset liberado)
sleep 0.3 2>/dev/null            # FT5336 ~300ms hasta listo

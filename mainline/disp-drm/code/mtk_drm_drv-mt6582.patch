## 1) Quitar DDP_COMPONENT_BLS del path mt2701 (no tenemos BLS/disp-pwm).
static const unsigned int mt2701_mtk_ddp_main[] = {
	DDP_COMPONENT_OVL0,
	DDP_COMPONENT_RDMA0,
	DDP_COMPONENT_COLOR0,
	DDP_COMPONENT_DSI0,        /* <- antes: COLOR0, BLS, DSI0 */
};

## 2) Data DRM del mt6582 + entrada en mtk_drm_of_ids (SIN esto: of_id=NULL -> -ENODEV,
##    el master mediatek-drm NUNCA enlazaba). El mmsys no tiene grafo -> path estatico.
static const struct mtk_mmsys_driver_data mt6582_mmsys_driver_data = {
	.main_path = mt2701_mtk_ddp_main,
	.main_len = ARRAY_SIZE(mt2701_mtk_ddp_main),
	.shadow_register = true,
	.mmsys_dev_num = 1,
};
/* en mtk_drm_of_ids[]: */
	{ .compatible = "mediatek,mt6582-mmsys",
	  .data = &mt6582_mmsys_driver_data},

## 3) Reconocer el RDMA variante mt6582 en la tabla de tipos del DRM (SIN esto el RDMA
##    no entraba al path -> "Failed to find comp in ddp table" -> fallaba el bind del DSI).
	{ .compatible = "mediatek,mt6582-disp-rdma",
	  .data = (void *)MTK_DISP_RDMA },


diff --git a/bsd/arm/param.h b/bsd/arm/param.h
index a7f7204..293c2ef 100644
--- a/bsd/arm/param.h
+++ b/bsd/arm/param.h
@@ -87,6 +87,11 @@
 #define	M16KCLBYTES	(1 << M16KCLSHIFT)	/* size of a jumbo cluster */
 
 #define	MCLOFSET	(MCLBYTES - 1)
+/* fallback CONFIG_NMBCLUSTERS: la seleccion por etiquetas del MASTER no lo emite
+ * para maquinas nuevas; usamos el valor <bsmall> del MASTER */
+#undef CONFIG_NMBCLUSTERS
+#define CONFIG_NMBCLUSTERS      ((1024 * 256) / MCLBYTES)
+
 #ifndef NMBCLUSTERS
 #define	NMBCLUSTERS	CONFIG_NMBCLUSTERS	/* cl map size */
 #endif

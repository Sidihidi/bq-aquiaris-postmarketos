diff --git a/arch/arm/plat-mt6582/fb.c b/arch/arm/plat-mt6582/fb.c
index 669e13f..72b7437 100644
--- a/arch/arm/plat-mt6582/fb.c
+++ b/arch/arm/plat-mt6582/fb.c
@@ -54,11 +54,30 @@ void mt6582_console_init(void)
     fb_drawRect(0, 0, WIDTH, HEIGHT, BG_COLOR);
 }
 
+
+static void fb_scroll(void)
+{
+    volatile unsigned int *fb = (volatile unsigned int *)FB_BASE;
+    int line = (FONT_WIDTH + 1) * STRIDE_PX;         /* pixeles por linea de texto */
+    int total = HEIGHT * STRIDE_PX;
+    int y;
+    /* subir todo una linea */
+    for (y = 0; y < total - line; y++)
+        fb[y] = fb[y + line];
+    /* limpiar la ultima linea */
+    for (y = total - line; y < total; y++)
+        fb[y] = BG_COLOR;
+}
+
 void mt6582_console_putchar(char c)
 {
     if (c == 0x0A) {
         mt6582_console_row += (FONT_WIDTH + 1);
         mt6582_console_col = 0;
+        if (mt6582_console_row + FONT_WIDTH > HEIGHT) {
+            fb_scroll();
+            mt6582_console_row -= (FONT_WIDTH + 1);
+        }
         return;
     }
     mt6582_console_col += fb_drawChar(c, mt6582_console_row, mt6582_console_col);
@@ -66,6 +85,8 @@ void mt6582_console_putchar(char c)
         mt6582_console_row += (FONT_WIDTH + 1);
         mt6582_console_col = 0;
     }
-    if (mt6582_console_row + FONT_WIDTH > HEIGHT)   /* wrap arriba (simple) */
-        mt6582_console_row = 0;
+    if (mt6582_console_row + FONT_WIDTH > HEIGHT) {
+        fb_scroll();
+        mt6582_console_row -= (FONT_WIDTH + 1);
+    }
 }

@@ -141,8 +141,12 @@ void init_debug(void)
 void __assert_func(const char *file, int line, const char *method,
                    const char *expression)
 {
-    panic("Assertion failed in file %s, line %d. (%s)\n",
-          file, line, expression);
+    /* pantalla limpia + mensaje aislado arriba, imposible de solapar */
+    mt6582_console_init();
+    printf("\n\n>>>> ASSERT FALLO <<<<\n\n");

+        {
+            char tempbuf[16];
+            if (PE_parse_boot_argn("-xnu-vc", tempbuf, sizeof(tempbuf)))
+                draw_panic_dialog();
+        }
+
+        /*
+         * Y aqui se queda: repintando la consola en bucle.  Un panic no tiene
+         * vuelta atras, asi que lo unico que importa es que el mensaje y el
+         * backtrace SEAN VISIBLES.  Repintando sin parar, cualquier cosa que
+         * pinte encima dura un ciclo y queda tapada.

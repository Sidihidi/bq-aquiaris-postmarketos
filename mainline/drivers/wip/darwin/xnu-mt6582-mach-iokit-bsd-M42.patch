 {
+#ifdef BOARD_CONFIG_MT6582
+	/*
+	 * En el krillin la pantalla es de la consola de framebuffer del pexpert:
+	 * initialize_screen() esta gateado tras -xnu-vc para que vc_ no pinte
+	 * encima, asi que gc_ops se queda a NULL.  vcattach() arranca la
+	 * maquinaria de vc_ igualmente y acaba en gc_reset_vt100() ->
+	 * gc_update_color(), que revienta contra

+         * failed: %s"): dice el tipo de fallo pero no el fichero, la linea ni
+         * la condicion.  El texto expandido lo acumula debug_putc() en
+         * debug_buf — pero OJO: debug_buf recoge TODO el kdb_printf del
+         * arranque entero desde el primer instante, no solo el panico.  Su
+         * comienzo es el volcado de boot_args de arm_vm_init.  El mensaje que
+         * buscamos esta al FINAL, asi que localizamos la ULTIMA aparicion de
+         * "panic(" y volcamos desde ahi.
+         */
+        PE_early_puts("\n*** MOTIVO DEL PANIC ***\n");
+        {
+            extern char debug_buf[];
+            extern char *debug_buf_ptr;
+            static char motivo[420];
+            char *q, *found = (char *) 0;
+            int i = 0;
+
+            for (q = debug_buf; q + 6 < debug_buf_ptr; q++) {
+                if (q[0] == 'p' && q[1] == 'a' && q[2] == 'n' &&
+                    q[3] == 'i' && q[4] == 'c' && q[5] == '(')

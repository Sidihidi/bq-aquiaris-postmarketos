+        panic_arm_backtrace(stackptr, 12, NULL, FALSE, NULL);
+
+        /*
+         * draw_panic_dialog() repinta el framebuffer ENTERO con la imagen de
+         * pánico de XNU, borrando el mensaje y el backtrace que acabamos de
+         * escribir — es el "rojo plano" que tapaba el diagnóstico.  En el

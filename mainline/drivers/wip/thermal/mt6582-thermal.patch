+/*
+ * raw_to_mcelsius_v1_mt6582 - MT6582 downstream conversion
+ *
+ * Same fuse layout as V1, but the downstream (mtk_ts_cpu.c) math uses
+ * the scaled gain (10000 + (ge - 512) * 10000 / 4096), the ADC offset
+ * (oe - 512), the x_roomt term with the +3350 constant, a 15/18 slope
+ * factor and the *opposite* o_slope sign convention to v2:
+ *
+ *   T (0.1 degC) = degc_cali * 10 / 2
+ *		    - [ ((raw - oe)*10^4/4096*10^4/gain - x_roomt)
+ *			* 15/18 * 100 / (165 +/- o_slope) ]
+ */
+static int raw_to_mcelsius_v1_mt6582(struct mtk_thermal *mt, int sensno,
+				     s32 raw)
+{
+	s32 format_1;
+	s32 format_2;
+	s32 g_oe;
+	s32 g_gain;
+	s32 g_x_roomt;
+	s32 tmp;
+
+	if (raw == 0)
+		return 0;
+
+	raw &= 0xfff;
+	g_gain = 10000 + (((mt->adc_ge - 512) * 10000) >> 12);
+	g_oe = mt->adc_oe - 512;
+	format_1 = mt->vts[mt->conf->vts_index[sensno]] + 3350 - g_oe;
+	format_2 = (mt->degc_cali * 10) >> 1;
+	g_x_roomt = (((format_1 * 10000) >> 12) * 10000) / g_gain;
+
+	tmp = (((((raw - g_oe) * 10000) >> 12) * 10000) / g_gain) - g_x_roomt;
+	tmp = tmp * 15 * 100 / 18;
+
+	/*
+	 * The v1 fuse parser already folds the sign into o_slope
+	 * (o_slope < 0 when ID & O_SLOPE_SIGN), which matches the
+	 * downstream "sign == 0 -> /(165 + slope), else /(165 - slope)".
+	 */
+	tmp = tmp / (165 + mt->o_slope);
+
+	return (format_2 - tmp) * 100;
+}

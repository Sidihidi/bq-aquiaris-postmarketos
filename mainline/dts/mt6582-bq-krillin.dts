// SPDX-License-Identifier: GPL-2.0+
/*
 * BQ Aquaris E4.5 (krillin) — MT6582
 * Primer intento mainline: simple-framebuffer sobre el FB que deja el LK
 * (panel hx8389 qHD DSI modo video, se auto-refresca) + ramoops post-mortem.
 * FB fisico 0xBF400000 (region 12 MB reservada, vista en /proc/iomem del
 * kernel downstream 3.10). stride 2176 = 544*4.
 */

/dts-v1/;
#include "mt6582.dtsi"

/ {
	model = "BQ Aquaris E4.5";
	compatible = "bq,krillin", "mediatek,mt6582";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		bootargs = "panic=15 clk_ignore_unused";

		framebuffer0: framebuffer@bf400000 {
			compatible = "simple-framebuffer";
			reg = <0xbf400000 0x200000>;
			width = <540>;
			height = <960>;
			stride = <2176>;
			format = "a8r8g8b8";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* region del framebuffer del LK (mtkfb.0 en downstream) */
		fb_region: framebuffer-region@bf400000 {
			reg = <0xbf400000 0xb00000>;
			no-map;
		};

		/* ultimo MB de la region reservada: logs que sobreviven al reboot */
		ramoops@bf300000 {
			compatible = "ramoops";
			reg = <0xbf300000 0x100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x20000>;
		};
	};
};

&uart0 {
	status = "okay";
};

/ {
	/* relojes fijos para el MSDC: el LK los deja encendidos
	 * (clk_ignore_unused evita que se apaguen) */

	reg_vmmc: regulator-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vqmmc: regulator-vqmmc {
		compatible = "regulator-fixed";
		regulator-name = "vqmmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	msdc_src: msdc-src-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};
	msdc_hclk: msdc-hclk-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};
};

&{/soc} {
	mmc0: mmc@11230000 {
		compatible = "mediatek,mt8135-mmc";
		reg = <0x11230000 0x1000>;
		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&msdc_src>, <&msdc_hclk>;
		clock-names = "source", "hclk";
		vmmc-supply = <&reg_vmmc>;
		vqmmc-supply = <&reg_vqmmc>;
		bus-width = <8>;
		max-frequency = <25000000>;
		non-removable;
		no-sd;
		no-sdio;
		status = "okay";
	};
};

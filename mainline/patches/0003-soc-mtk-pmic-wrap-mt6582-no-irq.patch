# Cambios en drivers/soc/mediatek/mtk-pmic-wrap.c para el MT6582 (krillin)
# Linux 7.0.12. El árbol NO es git -> esto es referencia de secciones (aplicar a mano
# sobre el driver upstream), no un diff con `patch`. SUPERSEDE al 0002 (allí
# int_en_all = ~(BIT31|BIT2); el storm obligó a dejarlo en 0 + saltar la IRQ).

## 1) enum pwrap_type  -> añadir:
	PWRAP_MT6582,

## 2) nueva variante pmic_wrapper_type:
static const struct pmic_wrapper_type pwrap_mt6582 = {
	.regs = mt2701_regs,            /* offsets WACS2 (0x9c/a0/a4) validados por poke */
	.type = PWRAP_MT6582,
	.arb_en_all = 0x3f,
	.int_en_all = 0,                /* polling; INT_EN=0 NO enmascara la linea SPI en este SoC */
	.int1_en_all = 0,
	.spi_w = PWRAP_MAN_CMD_SPI_WRITE_NEW,
	.wdt_src = PWRAP_WDT_SRC_MASK_ALL,
	.caps = 0,                      /* sin reset-controller -> NO PWRAP_CAP_RESET (evita probe -2/ENOENT) */
	.init_reg_clock = pwrap_mt2701_init_reg_clock,
	.init_soc_specific = NULL,      /* el LK ya hizo pwrap_init (INIT_DONE2=1) -> driver lo salta */
};

## 3) of_match_table del driver -> añadir:
	{ .compatible = "mediatek,mt6582-pwrap", .data = &pwrap_mt6582 },

## 4) en pwrap_probe(): envolver el bloque request_irq para SALTARLO si int_en_all==0.
##    (sin esto: tormenta infinita "mt-pmic-pwrap 1000d000.pwrap: unexpected interrupt
##     int=0x2" que inunda la consola fb y cuelga el arranque. INT_EN=0 NO basta porque
##     la escritura va al offset INT_EN de mt2701, que no enmascara la linea en MT6582.)
	if (wrp->master->int_en_all) {
		irq = platform_get_irq(pdev, 0);
		if (irq < 0)
			return irq;
		ret = devm_request_irq(wrp->dev, irq, pwrap_interrupt,
				       IRQF_TRIGGER_HIGH, "mt-pmic-pwrap", wrp);
		if (ret)
			return ret;
	}


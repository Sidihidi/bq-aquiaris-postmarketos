#include <linux/delay.h>
#include <linux/io.h>
#include <linux/memblock.h>
#include <linux/of.h>
#include <linux/of_address.h>
#include <linux/string.h>
#include <linux/threads.h>

#define MTK_MAX_CPU		8
#define MTK_SMP_REG_SIZE	0x1000

struct mtk_smp_boot_info {
	unsigned long smp_base;
	unsigned int jump_reg;
	unsigned int core_keys[MTK_MAX_CPU - 1];
	unsigned int core_regs[MTK_MAX_CPU - 1];
};

static const struct mtk_smp_boot_info mtk_mt8135_tz_boot = {
	0x80002000, 0x3fc,
	{ 0x534c4131, 0x4c415332, 0x41534c33 },
	{ 0x3f8, 0x3f8, 0x3f8 },
};

static const struct mtk_smp_boot_info mtk_mt6572_boot = {
	0x10001400, 0x08,
	{ 0x534c4131 },
	{ 0x0c },
};

static const struct mtk_smp_boot_info mtk_mt6589_boot = {
	0x10002000, 0x34,
	{ 0x534c4131, 0x4c415332, 0x41534c33 },
	{ 0x38, 0x3c, 0x40 },
};

static const struct mtk_smp_boot_info mtk_mt7623_boot = {
	0x10202000, 0x34,
	{ 0x534c4131, 0x4c415332, 0x41534c33 },
	{ 0x38, 0x3c, 0x40 },
};

static const struct of_device_id mtk_tz_smp_boot_infos[] __initconst = {
	{ .compatible   = "mediatek,mt8135", .data = &mtk_mt8135_tz_boot },
	{ .compatible   = "mediatek,mt8127", .data = &mtk_mt8135_tz_boot },
	{ .compatible   = "mediatek,mt2701", .data = &mtk_mt8135_tz_boot },
	{},
};

static const struct of_device_id mtk_smp_boot_infos[] __initconst = {
	{ .compatible   = "mediatek,mt6572", .data = &mtk_mt6572_boot },
	{ .compatible   = "mediatek,mt6582", .data = &mtk_mt7623_boot },
	{ .compatible   = "mediatek,mt6589", .data = &mtk_mt6589_boot },
	{ .compatible   = "mediatek,mt7623", .data = &mtk_mt7623_boot },
	{ .compatible   = "mediatek,mt7629", .data = &mtk_mt7623_boot },
	{},
};

static void __iomem *mtk_smp_base;
static const struct mtk_smp_boot_info *mtk_smp_info;

#ifdef CONFIG_HOTPLUG_CPU
/* SPM M2 (mt6582): MTCMOS real de los cores 1-3 (port de mt_spm_mtcmos.c del
 * downstream). cpu_die = WFI en el core; cpu_kill (desde otro core) espera el
 * APMCUx_SLEEP del SPM y APAGA el dominio FCx; boot_secondary lo REENCIENDE
 * antes del boot normal — asi el core re-arranca por el BootROM y el suspend
 * 'mem' del SPM recupera los 4 cores tras el resume. */
#define M2_SPM_POWERON_CONFIG_SET 0x000
#define M2_SPM_PWR_STATUS      0x60c
#define M2_SPM_PWR_STATUS_S    0x610
#define M2_SPM_SLEEP_TIMER_STA 0x720
#define M2_FCX_PWR_CON(cpu)    (0x218 + ((cpu) - 1) * 4)  /* FC1/2/3 */
#define M2_FCX_L1_PDN(cpu)     (0x264 + ((cpu) - 1) * 8)
#define M2_FCX_STA(cpu)        BIT(12 - (cpu))            /* FC1=b11..FC3=b9 */
#define M2_APMCUX_SLEEP(cpu)   BIT(15 + (cpu))
#define M2_SRAM_ISOINT_B  BIT(6)
#define M2_SRAM_CKISO     BIT(5)
#define M2_PWR_CLK_DIS    BIT(4)
#define M2_PWR_ON_S       BIT(3)
#define M2_PWR_ON         BIT(2)
#define M2_PWR_ISO        BIT(1)
#define M2_PWR_RST_B      BIT(0)

static void __iomem *m2_spm;
static DEFINE_SPINLOCK(m2_lock);

static bool m2_map(void)
{
	if (!m2_spm && of_machine_is_compatible("mediatek,mt6582"))
		m2_spm = ioremap(0x10006000, 0x1000);
	return m2_spm != NULL;
}

static u32 m2_r(u32 o) { return readl(m2_spm + o); }
static void m2_w(u32 o, u32 v) { writel(v, m2_spm + o); dsb(sy); }

static int m2_poll(u32 off, u32 mask, u32 want, int us)
{
	while (us-- > 0) {
		if ((m2_r(off) & mask) == want)
			return 0;
		udelay(1);
	}
	return -ETIMEDOUT;
}

static void m2_cpu_power_on(unsigned int cpu)
{
	unsigned long flags;

	m2_w(M2_SPM_POWERON_CONFIG_SET, (0xb16 << 16) | 1);
	spin_lock_irqsave(&m2_lock, flags);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_PWR_ON);
	udelay(1);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_PWR_ON_S);
	m2_poll(M2_SPM_PWR_STATUS, M2_FCX_STA(cpu), M2_FCX_STA(cpu), 10000);
	m2_poll(M2_SPM_PWR_STATUS_S, M2_FCX_STA(cpu), M2_FCX_STA(cpu), 10000);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_PWR_CLK_DIS);
	m2_w(M2_FCX_L1_PDN(cpu), m2_r(M2_FCX_L1_PDN(cpu)) & ~BIT(0));
	m2_poll(M2_FCX_L1_PDN(cpu), BIT(8), 0, 10000);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_SRAM_ISOINT_B);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_SRAM_CKISO);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_PWR_ISO);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_PWR_RST_B);
	spin_unlock_irqrestore(&m2_lock, flags);
}

static void m2_cpu_power_off(unsigned int cpu)
{
	unsigned long flags;

	m2_w(M2_SPM_POWERON_CONFIG_SET, (0xb16 << 16) | 1);
	spin_lock_irqsave(&m2_lock, flags);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_SRAM_CKISO);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_SRAM_ISOINT_B);
	m2_w(M2_FCX_L1_PDN(cpu), m2_r(M2_FCX_L1_PDN(cpu)) | BIT(0));
	m2_poll(M2_FCX_L1_PDN(cpu), BIT(8), BIT(8), 10000);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) | M2_PWR_ISO);
	m2_w(M2_FCX_PWR_CON(cpu),
	     (m2_r(M2_FCX_PWR_CON(cpu)) | M2_PWR_CLK_DIS) & ~M2_PWR_RST_B);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_PWR_ON);
	m2_w(M2_FCX_PWR_CON(cpu), m2_r(M2_FCX_PWR_CON(cpu)) & ~M2_PWR_ON_S);
	m2_poll(M2_SPM_PWR_STATUS, M2_FCX_STA(cpu), 0, 10000);
	m2_poll(M2_SPM_PWR_STATUS_S, M2_FCX_STA(cpu), 0, 10000);
	spin_unlock_irqrestore(&m2_lock, flags);
}

static void mtk_cpu_die(unsigned int cpu)
{
	while (1)
		wfi();
}

static int mtk_cpu_kill(unsigned int cpu)
{
	if (!m2_map() || cpu < 1 || cpu > 3)
		return 1;
	/* esperar a que el SPM vea el core en WFI antes de cortarle la luz */
	m2_poll(M2_SPM_SLEEP_TIMER_STA, M2_APMCUX_SLEEP(cpu),
		M2_APMCUX_SLEEP(cpu), 100000);
	m2_cpu_power_off(cpu);
	return 1;
}
#endif

static int mtk_boot_secondary(unsigned int cpu, struct task_struct *idle)
{
	if (!mtk_smp_base)
		return -EINVAL;

	if (!mtk_smp_info->core_keys[cpu-1])
		return -EINVAL;

#ifdef CONFIG_HOTPLUG_CPU
	/* SPM M2: si el core esta apagado por MTCMOS (cpu_kill/suspend),
	 * reencenderlo — re-arranca por el BootROM y coge la boot addr */
	if (m2_map() && !(m2_r(M2_SPM_PWR_STATUS) & M2_FCX_STA(cpu)))
		m2_cpu_power_on(cpu);
#endif

	writel_relaxed(mtk_smp_info->core_keys[cpu-1],
		mtk_smp_base + mtk_smp_info->core_regs[cpu-1]);

	arch_send_wakeup_ipi_mask(cpumask_of(cpu));

	return 0;
}

static void __init __mtk_smp_prepare_cpus(unsigned int max_cpus, int trustzone)
{
	int i, num;
	const struct of_device_id *infos;

	if (trustzone) {
		num = ARRAY_SIZE(mtk_tz_smp_boot_infos);
		infos = mtk_tz_smp_boot_infos;
	} else {
		num = ARRAY_SIZE(mtk_smp_boot_infos);
		infos = mtk_smp_boot_infos;
	}

	/* Find smp boot info for this SoC */
	for (i = 0; i < num; i++) {
		if (of_machine_is_compatible(infos[i].compatible)) {
			mtk_smp_info = infos[i].data;
			break;
		}
	}

	if (!mtk_smp_info) {
		pr_err("%s: Device is not supported\n", __func__);
		return;
	}

	if (trustzone) {
		/* smp_base(trustzone-bootinfo) is reserved by device tree */
		mtk_smp_base = phys_to_virt(mtk_smp_info->smp_base);
	} else {
		mtk_smp_base = ioremap(mtk_smp_info->smp_base, MTK_SMP_REG_SIZE);
		if (!mtk_smp_base) {
			pr_err("%s: Can't remap %lx\n", __func__,
				mtk_smp_info->smp_base);
			return;
		}
	}

	/*
	 * write the address of slave startup address into the system-wide
	 * jump register
	 */
	writel_relaxed(__pa_symbol(secondary_startup_arm),
			mtk_smp_base + mtk_smp_info->jump_reg);
}

static void __init mtk_tz_smp_prepare_cpus(unsigned int max_cpus)
{
	__mtk_smp_prepare_cpus(max_cpus, 1);
}

static void __init mtk_smp_prepare_cpus(unsigned int max_cpus)
{
	__mtk_smp_prepare_cpus(max_cpus, 0);
}

static const struct smp_operations mt81xx_tz_smp_ops __initconst = {
	.smp_prepare_cpus = mtk_tz_smp_prepare_cpus,
	.smp_boot_secondary = mtk_boot_secondary,
};
CPU_METHOD_OF_DECLARE(mt81xx_tz_smp, "mediatek,mt81xx-tz-smp", &mt81xx_tz_smp_ops);


static const struct smp_operations mt6589_smp_ops __initconst = {
	.smp_prepare_cpus = mtk_smp_prepare_cpus,
	.smp_boot_secondary = mtk_boot_secondary,
#ifdef CONFIG_HOTPLUG_CPU
	.cpu_die = mtk_cpu_die,
	.cpu_kill = mtk_cpu_kill,
#endif
};
CPU_METHOD_OF_DECLARE(mt6589_smp, "mediatek,mt6589-smp", &mt6589_smp_ops);
